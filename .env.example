DISCORD_BOT_TOKEN=

# Shared model-provider plugins. Production can route across all configured
# providers while harnesses remain provider-neutral.
OPEN_ROUTER_API=
OPEN_ROUTER_MODEL=stealth/ox-alpha
OPEN_ROUTER_FALLBACK_MODELS=
OPEN_ROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPEN_ROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
OPEN_ROUTER_MAX_ATTEMPTS=3
OPEN_ROUTER_TIMEOUT_SECONDS=180
OPEN_ROUTER_DISCOVERY_TIMEOUT_SECONDS=15
OPEN_ROUTER_MAX_TOKENS=16384

# Ollama Cloud/local remains a drop-in route for private or redundant inference.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_FALLBACK_MODELS=
OLLAMA_URL=https://ollama.com/api/chat
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_TIMEOUT_SECONDS=180

# Direct OpenAI-compatible providers. Lower-case Railway variable names such as
# groq_api_key, gemini_api_key and nvidia_api_key are accepted by the runtime too.
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MAX_ATTEMPTS=2
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_TOKENS=16384

GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MAX_ATTEMPTS=2
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_TOKENS=16384

NVIDIA_API_KEY=
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MAX_ATTEMPTS=2
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_TOKENS=16384

OPERLY_PLANNING_MODEL_SLICE_SECONDS=120
OPERLY_MAX_CONCURRENT_PLANS=1

# Global compatibility route. When two or more model providers are configured,
# OPERLY_MODEL_AUTO_PORTFOLIO=1 builds role-specific, provider-diverse pools from
# model cards instead of pinning every role to this one route.
OPERLY_MODEL_PROVIDER=openrouter
OPERLY_MODEL_DEFAULT=stealth/ox-alpha
OPERLY_MODEL_DISCOVERY_TTL_SECONDS=600
OPERLY_MODEL_AUTO_PORTFOLIO=1
# A failed model/provider is temporarily skipped and the successful fallback is
# sticky within that ModelPool, avoiding the same timeout on every agent turn.
OPERLY_MODEL_POOL_COOLDOWN_SECONDS=45

# Role-based compatibility overrides. Explicit *_CANDIDATES_JSON takes precedence
# over automatic portfolio selection. Example:
# OPERLY_MODEL_CODING_CANDIDATES_JSON=[{"provider":"groq","model":"openai/gpt-oss-120b"},{"provider":"ollama","model":"gemma4:31b"},{"provider":"nvidia","model":"nvidia/nemotron-3-ultra-550b-a55b"},{"provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free"},{"provider":"gemini","model":"gemini-3.6-flash"}]
OPERLY_MODEL_REQUIREMENTS_ANALYST_PROVIDER=openrouter
OPERLY_MODEL_REQUIREMENTS_ANALYST=stealth/ox-alpha
OPERLY_MODEL_REQUIREMENTS_ANALYST_FALLBACKS=
OPERLY_MODEL_PLANNER_PROVIDER=openrouter
OPERLY_MODEL_PLANNER=stealth/ox-alpha
OPERLY_MODEL_PLANNER_FALLBACKS=
OPERLY_MODEL_GLOBAL_VALIDATOR_PROVIDER=openrouter
OPERLY_MODEL_GLOBAL_VALIDATOR=stealth/ox-alpha
OPERLY_MODEL_GLOBAL_VALIDATOR_FALLBACKS=
OPERLY_MODEL_CODING_PROVIDER=openrouter
OPERLY_MODEL_CODING=stealth/ox-alpha
OPERLY_MODEL_CODING_FALLBACKS=
OPERLY_MODEL_CODING_CANDIDATES_JSON=
OPERLY_MODEL_REPAIR_PROVIDER=openrouter
OPERLY_MODEL_REPAIR=stealth/ox-alpha
OPERLY_MODEL_REPAIR_FALLBACKS=
OPERLY_MODEL_CAPABILITY_PLACEMENT_PROVIDER=openrouter
OPERLY_MODEL_CAPABILITY_PLACEMENT=stealth/ox-alpha
OPERLY_MODEL_CAPABILITY_PLACEMENT_FALLBACKS=
OPERLY_MODEL_BUSINESS_AGENT_PROVIDER=openrouter
OPERLY_MODEL_BUSINESS_AGENT=stealth/ox-alpha
OPERLY_MODEL_BUSINESS_AGENT_FALLBACKS=
OPERLY_MODEL_BOUNDED_TASK_PROVIDER=openrouter
OPERLY_MODEL_BOUNDED_TASK=stealth/ox-alpha
OPERLY_MODEL_BOUNDED_TASK_FALLBACKS=

# Additional model cards exposed to Operly's capability router. Built-in verified
# free cards are activated automatically for configured providers. Custom objects
# may add provider/id/capabilities/free/priority/tags plus canonical_id,
# billing_mode, input_cost_per_million, output_cost_per_million, and
# verified_latency_ms.
OPERLY_MODEL_CATALOG_JSON=

# Required application settings. Generate strong, unique values locally and in
# Railway; never commit their real values.
OPERLY_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
SESSION_SECRET=
AUTH_TOKEN_PEPPER=
# Dedicated Google sign-in credentials. These are separate from the
# Gmail/Calendar connector credentials below.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ChatGPT remote MCP. The Operly owner grants ChatGPT workspace scopes first;
# OAuth can never expand beyond those stored ClientGrant scopes. Use a separate
# random signing secret in production. Add the exact callback URI shown by
# ChatGPT when configuring the custom MCP app.
MCP_OAUTH_SECRET=
CHATGPT_MCP_CLIENT_SECRET=
CHATGPT_MCP_REDIRECT_URIS=

# OPERLY authentication and security email. Keep real credentials only in the
# deployment secret store. Railway Hobby must use the HTTPS Zoho Mail API.
MAIL_PROVIDER=zoho_mail_api
OPERLY_FROM_EMAIL=operly@dragonzpyder.xyz
OPERLY_FROM_NAME=OPERLY
# Zoho Mail REST API OAuth. Use ZohoMail.messages.CREATE and the regional
# accounts/mail endpoints shown in your signed-in Zoho Mail URL.
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com/api
ZOHO_MAIL_TIMEOUT_SECONDS=15
# SMTP remains available for hosts that permit outbound SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=operly@dragonzpyder.xyz
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Fernet key for encrypted OAuth tokens. Generate once with Fernet.generate_key().
OPERLY_CONNECTOR_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback
ADMIN_EMAIL=admin@operly.local
ADMIN_PASSWORD=
DEFAULT_TENANT_NAME=My Business

# Local fallback:
DATABASE_URL=sqlite+aiosqlite:///./operly.db

# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/operly

BOT_OWNER_IDS=
DEFAULT_TIMEZONE=UTC
STUDIO_ASSET_DIR=./studio_assets
OPERLY_PLANNING_MODE=live_llm

# OpenCode-inspired OPERLY coding-agent loop.
OPERLY_CODING_AGENT_MAX_STEPS=56
OPERLY_CODING_AGENT_MAX_SECONDS=240
OPERLY_CODING_AGENT_MODEL_SLICE_SECONDS=90
OPERLY_CODING_SOURCE_CONTRACT_REPAIRS=2
OPERLY_CODING_CONTEXT_CHARS=96000
OPERLY_CODING_CONTEXT_RECENT_MESSAGES=14

# Optional current-documentation tools backed by Ollama web_search/web_fetch.
# These remain an Ollama-specific optional plugin and do not affect model routing.
OPERLY_CODING_WEB_TOOLS=1
OPERLY_CODING_WEB_TIMEOUT_SECONDS=20

# Production generated-software execution. This must point to the dedicated
# apps/runner service described in apps/runner/README.md, running on genuine
# per-job container/microVM isolation. Do not point these at the Operly API
# service and do not emulate production with a normal Railway subprocess.
OPERLY_SANDBOX_RUNNER_URL=
OPERLY_SANDBOX_RUNNER_TOKEN=
OPERLY_SANDBOX_RUNNER_HOSTS=
OPERLY_SANDBOX_PREVIEW_HOSTS=

# Development/test only. This runs generated code as a constrained subprocess,
# not an OS-isolated container. Never enable it in production.
OPERLY_ENABLE_TEST_SUBPROCESS_RUNNER=0
