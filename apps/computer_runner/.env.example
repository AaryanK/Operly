# Reference Agent Computer runner. Development only.
OPERLY_ENV=development
OPERLY_AGENT_COMPUTER_DEV_RUNNER=1
OPERLY_AGENT_COMPUTER_RUNNER_TOKEN=replace-with-a-long-random-shared-secret
OPERLY_AGENT_COMPUTER_RUNNER_ROOT=./.agent-computer-runtime

# Operly API/control-plane configuration points to the separate runner service:
# OPERLY_AGENT_COMPUTER_RUNNER_URL=http://127.0.0.1:8092
# OPERLY_AGENT_COMPUTER_RUNNER_TOKEN=replace-with-the-same-long-random-shared-secret
# OPERLY_AGENT_COMPUTER_TIMEOUT_SECONDS=120
