# Web
APP_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@operly.local
ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_TENANT_NAME=My Business
PUBLIC_BASE_URL=https://overly.dragonzpyder.xyz

# Database
# Railway may inject postgres:// or postgresql://; OPERLY normalizes either.
DATABASE_URL=postgresql://operly:change-this-password@postgres:5432/operly

# Discord + Ollama
DISCORD_BOT_TOKEN=
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_FALLBACK_MODEL=
OLLAMA_URL=https://ollama.com/api/chat
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_TIMEOUT_SECONDS=180

# Mount a persistent Railway volume here.
STUDIO_ASSET_DIR=/app/studio_assets
